<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Borrower Views -->
        <record id="view_borrower_tree" model="ir.ui.view">
            <field name="name">borrower.tree</field>
            <field name="model">p2p.borrower</field>
            <field name="arch" type="xml">
                <list string="Người vay">
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="monthly_income"/>
                    <field name="credit_score"/>
                    <field name="total_loans"/>
                    <field name="active_loans"/>
                    <field name="status"/>
                    <field name="sync_status"/>
                </list>
            </field>
        </record>

        <record id="view_borrower_form" model="ir.ui.view">
            <field name="name">borrower.form</field>
            <field name="model">p2p.borrower</field>
            <field name="arch" type="xml">
                <form string="Người vay">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="sync_from_server" type="object" class="oe_stat_button" icon="fa-sync">
                                <field name="sync_status" widget="statinfo" string="Sync Status"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="user_id"/>
                                <field name="phone"/>
                                <field name="email"/>
                                <field name="identity_card"/>
                            </group>
                            <group>
                                <field name="address"/>
                                <field name="date_of_birth"/>
                                <field name="employment_status"/>
                                <field name="status"/>
                            </group>
                        </group>
                        <group>
                            <group string="Thông tin tài chính">
                                <field name="monthly_income"/>
                                <field name="credit_score"/>
                            </group>
                            <group string="Thống kê khoản vay">
                                <field name="total_loans"/>
                                <field name="active_loans"/>
                                <field name="total_borrowed"/>
                                <field name="total_repaid"/>
                            </group>
                        </group>
                        <group>
                            <group string="Đồng bộ">
                                <field name="sync_status"/>
                                <field name="last_sync"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
