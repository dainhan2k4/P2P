<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Disbursement Sequence -->
        <record id="seq_loan_disbursement" model="ir.sequence">
            <field name="name">Loan Disbursement</field>
            <field name="code">loan.disbursement</field>
            <field name="prefix">DISB</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Loan Application Sequence -->
        <record id="seq_loan_application" model="ir.sequence">
            <field name="name">Loan Application</field>
            <field name="code">loan.application</field>
            <field name="prefix">APP</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
