<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Loan Types -->
        <record id="loan_type_personal" model="loan.type">
            <field name="name">Vay cá nhân</field>
            <field name="code">PERSONAL</field>
            <field name="interest_rate">12.0</field>
            <field name="term_months">12</field>
            <field name="min_amount">1000000</field>
            <field name="max_amount">50000000</field>
            <field name="service_fee_rate">5.0</field>
            <field name="late_fee_rate">2.0</field>
            <field name="description">Khoản vay cá nhân với lãi suất ưu đãi</field>
        </record>

        <record id="loan_type_business" model="loan.type">
            <field name="name">Vay kinh doanh</field>
            <field name="code">BUSINESS</field>
            <field name="interest_rate">15.0</field>
            <field name="term_months">24</field>
            <field name="min_amount">10000000</field>
            <field name="max_amount">500000000</field>
            <field name="service_fee_rate">3.0</field>
            <field name="late_fee_rate">1.5</field>
            <field name="description">Khoản vay dành cho doanh nghiệp</field>
        </record>

        <record id="loan_type_emergency" model="loan.type">
            <field name="name">Vay khẩn cấp</field>
            <field name="code">EMERGENCY</field>
            <field name="interest_rate">18.0</field>
            <field name="term_months">6</field>
            <field name="min_amount">500000</field>
            <field name="max_amount">10000000</field>
            <field name="service_fee_rate">8.0</field>
            <field name="late_fee_rate">3.0</field>
            <field name="description">Khoản vay khẩn cấp với thủ tục nhanh</field>
        </record>

        <!-- Default Configuration -->
        <record id="loan_config_default" model="loan.config">
            <field name="name">Cấu hình mặc định</field>
            <field name="min_loan_amount">1000000</field>
            <field name="max_loan_amount">1000000000</field>
            <field name="base_interest_rate">12.0</field>
            <field name="max_interest_rate">36.0</field>
            <field name="service_fee_rate">5.0</field>
            <field name="late_fee_rate">2.0</field>
            <field name="processing_fee">50000</field>
            <field name="auto_approval_limit">5000000</field>
            <field name="max_concurrent_loans">3</field>
            <field name="server_enabled">True</field>
            <field name="server_api_url">http://192.168.1.6:3000</field>
            <field name="server_sync_interval">30</field>
        </record>
    </data>
</odoo>
