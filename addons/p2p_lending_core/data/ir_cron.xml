<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Auto Upgrade Cron Job -->
        <record id="cron_auto_upgrade" model="ir.cron">
            <field name="name">P2P Auto Upgrade</field>
            <field name="model_id" ref="base.model_ir_module_module"/>
            <field name="state">code</field>
            <field name="code">model.auto_upgrade_p2p_core()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <!-- Auto Sync Cron Job -->
        <record id="cron_auto_sync" model="ir.cron">
            <field name="name">P2P Auto Sync</field>
            <field name="model_id" ref="p2p_lending_core.model_p2p_bridge"/>
            <field name="state">code</field>
            <field name="code">model.sync_from_mongo()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
