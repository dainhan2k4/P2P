<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Credit Model Tree View -->
    <record id="credit_model_view_tree" model="ir.ui.view">
        <field name="name">credit.model.tree.view</field>
        <field name="model">credit.model</field>
        <field name="type">tree</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="model_type"/>
                <field name="version"/>
                <field name="write_date" string="Last Updated"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Credit Model Form View -->
    <record id="credit_model_view_form" model="ir.ui.view">
        <field name="name">credit.model.form.view</field>
        <field name="model">credit.model</field>
        <field name="type">form</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="toggle_active" type="object" class="oe_highlight" attrs="{'invisible': [('active', '=', False)]}" string="Archive"/>
                    <button name="toggle_active" type="object" attrs="{'invisible': [('active', '=', True)]}" string="Unarchive"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Model Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_type"/>
                            <field name="version"/>
                            <field name="creation_date"/>
                            <field name="write_date" string="Last Updated" readonly="1"/>
                        </group>
                        <group>
                            <field name="accuracy"/>
                            <field name="auc"/>
                            <field name="gini"/>
                            <field name="ks_statistic"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Model File">
                            <group>
                                <field name="model_file" filename="model_filename"/>
                                <field name="model_filename" invisible="1"/>
                            </group>
                        </page>
                        <page string="Description">
                            <field name="description" placeholder="Model description..."/>
                        </page>
                        <page string="Feature Importance">
                            <field name="feature_importance"/>
                        </page>
                        <page string="Parameters">
                            <field name="parameters"/>
                        </page>
                        <page string="Credit Policies">
                            <field name="credit_policy_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="min_score"/>
                                    <field name="max_pd"/>
                                    <field name="decision"/>
                                    <field name="active"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Credit Model Search View -->
    <record id="credit_model_view_search" model="ir.ui.view">
        <field name="name">credit.model.search.view</field>
        <field name="model">credit.model</field>
        <field name="type">search</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_type"/>
                <filter string="PD Models" name="pd_models" domain="[('model_type', '=', 'pd')]"/>
                <filter string="EAD Models" name="ead_models" domain="[('model_type', '=', 'ead')]"/>
                <filter string="LGD Models" name="lgd_models" domain="[('model_type', '=', 'lgd')]"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Model Type" name="group_by_type" context="{'group_by': 'model_type'}"/>
                    <filter string="Creation Date" name="group_by_date" context="{'group_by': 'creation_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Credit Model Action -->
    <record id="action_credit_model" model="ir.actions.act_window">
        <field name="name">Credit Models</field>
        <field name="res_model">credit.model</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="credit_model_view_search"/>
        <field name="context">{"search_default_active": 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first credit model
            </p>
            <p>
                Create different models for PD, EAD, and LGD calculations.
            </p>
        </field>
    </record>
</odoo>