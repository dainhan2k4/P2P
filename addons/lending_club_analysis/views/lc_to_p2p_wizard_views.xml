<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LC to P2P Wizard Form View -->
    <record id="view_lc_to_p2p_wizard_form" model="ir.ui.view">
        <field name="name">lc.to.p2p.wizard.form</field>
        <field name="model">lc.to.p2p.wizard</field>
        <field name="arch" type="xml">
            <form string="Chuyển đổi LC Loan sang P2P Loan">
                <sheet>
                    <div class="oe_title">
                        <h1>Chuyển đổi Lending Club sang P2P Loan</h1>
                        <p>Chuyển đổi dữ liệu Lending Club thành khoản vay P2P để quản lý và phân tích.</p>
                    </div>
                    
                    <group>
                        <group string="Tiêu chí lọc">
                            <field name="filter_criteria"/>
                            <field name="grade_filter" invisible="filter_criteria != 'grade_filter'"/>
                            <field name="min_amount" invisible="filter_criteria != 'amount_filter'"/>
                            <field name="max_amount" invisible="filter_criteria != 'amount_filter'"/>
                        </group>
                        <group string="Cấu hình">
                            <field name="create_mode"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Khoản vay được chọn" name="selected_loans">
                            <field name="lc_loan_ids" nolabel="1">
                                <list>
                                    <field name="loan_id"/>
                                    <field name="loan_amnt"/>
                                    <field name="grade"/>
                                    <field name="int_rate"/>
                                    <field name="loan_status"/>
                                    <field name="p2p_loan_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Xem trước" type="object" name="action_preview_selection" class="btn-secondary"/>
                    <button string="Chuyển đổi" type="object" name="action_convert_to_p2p" class="btn-primary"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for LC to P2P Wizard -->
    <record id="action_lc_to_p2p_wizard" model="ir.actions.act_window">
        <field name="name">Chuyển đổi LC sang P2P</field>
        <field name="res_model">lc.to.p2p.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
