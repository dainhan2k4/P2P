<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_train_models_wizard_form" model="ir.ui.view">
        <field name="name">train.models.wizard.form</field>
        <field name="model">train.models.wizard</field>
        <field name="arch" type="xml">
            <form string="Train Credit Risk Models">
                <sheet>
                    <group>
                        <field name="model_types" widget="radio"/>
                    </group>
                    <footer>
                        <button name="action_train_models" string="Train Models" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_train_models_wizard" model="ir.actions.act_window">
        <field name="name">Train Credit Risk Models</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">train.models.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>