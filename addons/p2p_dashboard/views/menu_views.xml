              sequence="10"/>
              
    <!-- Permission Checker Menu -->
    <menuitem id="menu_permission_checker"
              name="Kiểm tra quyền hạn"
              parent="menu_p2p_dashboard_root"
              action="action_permission_checker"
              sequence="98"/>
              
    <!-- Data Debug Menu -->
    <menuitem id="menu_data_debug_checker"
              name="Debug dữ liệu"
              parent="menu_p2p_dashboard_root"
              action="action_data_debug_checker"
              sequence="99"/>
