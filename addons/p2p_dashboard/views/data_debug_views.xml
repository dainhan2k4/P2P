<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Data Debug Checker Wizard -->
    <record id="view_data_debug_checker_form" model="ir.ui.view">
        <field name="name">p2p.data.debug.checker.form</field>
        <field name="model">p2p.data.debug.checker</field>
        <field name="arch" type="xml">
            <form string="P2P Data Debugger" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>Debug dữ liệu P2P Dashboard</h1>
                        <p>Công cụ kiểm tra tại sao Dashboard không hiển thị dữ liệu</p>
                    </div>
                    
                    <group>
                        <field name="result" widget="html" colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Debug ngay" name="debug_data_availability" type="object" class="btn-primary"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open Data Debug Checker -->
    <record id="action_data_debug_checker" model="ir.actions.act_window">
        <field name="name">Debug dữ liệu Dashboard</field>
        <field name="res_model">p2p.data.debug.checker</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>