<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_p2p_borrower_list" model="ir.ui.view">
        <field name="name">p2p.borrower.list</field>
        <field name="model">p2p.borrower</field>
        <field name="arch" type="xml">
            <list create="true" edit="true" string="Danh sách người vay">
                <field name="name"/>
                <field name="partner_id" widget="many2one_avatar"/>
                <field name="id_number"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="date_of_birth"/>
                <field name="gender"/>
                <field name="employment_status"/>
                <field name="monthly_income"/>
                <field name="credit_score_ml"/>
                <field name="city"/>
                <field name="state"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_p2p_borrower_form" model="ir.ui.view">
        <field name="name">p2p.borrower.form</field>
        <field name="model">p2p.borrower</field>
        <field name="arch" type="xml">
            <form string="Thông tin người vay">
                <header>
                    <button name="action_view_loans" string="Xem khoản vay" type="object" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <field name="active" widget="boolean_button" options="{'terminology': {'string_inactive': 'Lưu trữ', 'string_revert': 'Khôi phục'}}" class="oe_edit_only"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done" statusbar_colors='{"done": "success"}'/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Tên người vay"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Thông tin cá nhân">
                            <field name="partner_id" required="1"/>
                            <field name="id_number" required="1"/>
                            <field name="id_issue_date"/>
                            <field name="id_issue_place"/>
                            <field name="date_of_birth" required="1"/>
                            <field name="gender" required="1"/>
                            <field name="marital_status"/>
                            <field name="dependents_count"/>
                            <field name="nationality"/>
                            <field name="education_level"/>
                        </group>
                        <group string="Thông tin liên lạc">
                            <field name="phone" required="1"/>
                            <field name="phone_home"/>
                            <field name="email" required="1"/>
                            <field name="email_secondary"/>
                            <field name="emergency_contact_name"/>
                            <field name="emergency_contact_phone"/>
                            <field name="emergency_contact_relationship"/>
                        </group>
                    </group>
                    <group>
                        <group string="Địa chỉ">
                            <field name="address" required="1" nolabel="1" class="o_address_format"/>
                            <field name="address_temporary"/>
                            <field name="city" required="1"/>
                            <field name="district" required="1"/>
                            <field name="ward" required="1"/>
                            <field name="postal_code"/>
                        </group>
                        <group string="Việc làm &amp; Thu nhập">
                            <field name="employment_status" required="1"/>
                            <field name="employer_name"/>
                            <field name="employer_address"/>
                            <field name="job_title"/>
                            <field name="employment_length_years"/>
                            <field name="employment_length_months"/>
                            <field name="monthly_income" required="1"/>
                            <field name="annual_income" readonly="1"/>
                            <field name="income_source"/>
                            <field name="spouse_income"/>
                            <field name="monthly_expenses"/>
                        </group>
                    </group>
                    <group>
                        <group string="Tài chính &amp; Tín dụng">
                            <field name="home_ownership" required="1"/>
                            <field name="credit_score_ml" readonly="1"/>
                            <field name="credit_score_date" readonly="1"/>
                            <field name="has_credit_history"/>
                            <field name="credit_limit"/>
                            <field name="outstanding_debt"/>
                            <field name="revolving_utilization" readonly="1"/>
                            <field name="debt_to_income_ratio" readonly="1"/>
                            <field name="delinquent_accounts"/>
                            <field name="public_records"/>
                        </group>
                        <group string="Lịch sử tín dụng chi tiết">
                            <field name="open_accounts"/>
                            <field name="total_accounts"/>
                            <field name="revolving_balance"/>
                            <field name="inquiries_last_6_months"/>
                            <field name="fico_range_low"/>
                            <field name="fico_range_high"/>
                            <field name="last_credit_pull_date"/>
                            <field name="credit_utilization_trend"/>
                        </group>
                        <group string="Trạng thái">
                            <field name="state" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Thông tin liên hệ">
                            <group>
                                <field name="address" nolabel="1" class="o_address_format"/>
                            </group>
                        </page>
                        <page string="Khoản vay" invisible="not id">
                            <field name="loan_ids" context="{'default_borrower_id': id}">
                                <list string="Khoản vay" editable="bottom">
                                    <field name="name"/>
                                    <field name="amount"/>
                                    <field name="term"/>
                                    <field name="interest_rate"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_p2p_borrower_search" model="ir.ui.view">
        <field name="name">p2p.borrower.search</field>
        <field name="model">p2p.borrower</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm người vay">
                <field name="name" string="Tên"/>
                <field name="id_number" string="Số CMND/CCCD"/>
                <field name="phone" string="Điện thoại"/>
                <field name="email" string="Email"/>
                <separator/>
                <filter string="Đã xác nhận" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Nháp" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Đã lưu trữ" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Giới tính" name="group_gender" context="{'group_by': 'gender'}"/>
                    <filter string="Tình trạng việc làm" name="group_employment" context="{'group_by': 'employment_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="p2p_lending.action_p2p_borrower" model="ir.actions.act_window">
        <field name="name">Người vay</field>
        <field name="res_model">p2p.borrower</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có người vay nào. Hãy tạo mới!
            </p>
        </field>
    </record>
</odoo>