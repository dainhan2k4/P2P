<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Loan Payment Views -->
    <record id="p2p_lending.view_loan_payment_list" model="ir.ui.view">
        <field name="name">p2p.loan.payment.list</field>
        <field name="model">p2p.loan.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="payment_date"/>
                <field name="amount"/>
                <field name="principal"/>
                <field name="interest"/>
                <field name="balance"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="p2p_lending.view_loan_payment_form" model="ir.ui.view">
        <field name="name">p2p.loan.payment.form</field>
        <field name="model">p2p.loan.payment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="loan_id"/>
                            <field name="payment_date"/>
                            <field name="payment_date_actual"/>
                            <field name="state" widget="statusbar"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="principal"/>
                            <field name="interest"/>
                            <field name="balance"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Investment Payment Views -->
    <record id="p2p_lending.view_investment_payment_list" model="ir.ui.view">
        <field name="name">p2p.investment.payment.list</field>
        <field name="model">p2p.investment.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="payment_date"/>
                <field name="investment_id"/>
                <field name="amount"/>
                <field name="principal"/>
                <field name="interest"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="p2p_lending.view_investment_payment_form" model="ir.ui.view">
        <field name="name">p2p.investment.payment.form</field>
        <field name="model">p2p.investment.payment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="investment_id"/>
                            <field name="loan_id" readonly="1"/>
                            <field name="payment_date"/>
                            <field name="payment_date_actual"/>
                            <field name="state" widget="statusbar"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="principal"/>
                            <field name="interest"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="p2p_lending.action_loan_payment" model="ir.actions.act_window">
        <field name="name">Loan Payments</field>
        <field name="res_model">p2p.loan.payment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No payment records found. Let's create one!
            </p>
        </field>
    </record>

    <record id="p2p_lending.action_investment_payment" model="ir.actions.act_window">
        <field name="name">Investment Payments</field>
        <field name="res_model">p2p.investment.payment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No payment records found. Let's create one!
            </p>
        </field>
    </record>
</odoo>
