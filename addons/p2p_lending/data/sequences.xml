<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for P2P Loan numbering -->
        <record id="seq_p2p_loan" model="ir.sequence">
            <field name="name">P2P Loan</field>
            <field name="code">p2p.loan</field>
            <field name="prefix">LOAN</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Sequence for P2P Investment numbering -->
        <record id="seq_p2p_investment" model="ir.sequence">
            <field name="name">P2P Investment</field>
            <field name="code">p2p.investment</field>
            <field name="prefix">INV</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Sequence for P2P Investment Enhanced numbering -->
        <record id="seq_p2p_investment_enhanced" model="ir.sequence">
            <field name="name">P2P Investment Enhanced</field>
            <field name="code">p2p.investment.enhanced</field>
            <field name="prefix">INVE</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Sequence for P2P Investment Payment numbering -->
        <record id="seq_p2p_investment_payment" model="ir.sequence">
            <field name="name">P2P Investment Payment</field>
            <field name="code">p2p.investment.payment</field>
            <field name="prefix">PAY</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>